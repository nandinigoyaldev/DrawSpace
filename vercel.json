{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/api/save(\\.php)?",
      "dest": "/api/save.php"
    },
    {
      "src": "/api/load(\\.php)?",
      "dest": "/api/load.php"
    },
    {
      "src": "/save",
      "dest": "/api/save.php"
    },
    {
      "src": "/load",
      "dest": "/api/load.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
