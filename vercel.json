{
  "version": 2,
  "functions": {
    "api/clear.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.git,.git/**,**/.git/**,.env,.env.*,storage/**,.vercel/**,node_modules/**,vercel.json,.vercelignore}"
    },
    "api/load.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.git,.git/**,**/.git/**,.env,.env.*,storage/**,.vercel/**,node_modules/**,vercel.json,.vercelignore}"
    },
    "api/login.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.git,.git/**,**/.git/**,.env,.env.*,storage/**,.vercel/**,node_modules/**,vercel.json,.vercelignore}"
    },
    "api/logout.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.git,.git/**,**/.git/**,.env,.env.*,storage/**,.vercel/**,node_modules/**,vercel.json,.vercelignore}"
    },
    "api/me.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.git,.git/**,**/.git/**,.env,.env.*,storage/**,.vercel/**,node_modules/**,vercel.json,.vercelignore}"
    },
    "api/register.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.git,.git/**,**/.git/**,.env,.env.*,storage/**,.vercel/**,node_modules/**,vercel.json,.vercelignore}"
    },
    "api/request-reset.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.git,.git/**,**/.git/**,.env,.env.*,storage/**,.vercel/**,node_modules/**,vercel.json,.vercelignore}"
    },
    "api/reset-password.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.git,.git/**,**/.git/**,.env,.env.*,storage/**,.vercel/**,node_modules/**,vercel.json,.vercelignore}"
    },
    "api/rooms.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.git,.git/**,**/.git/**,.env,.env.*,storage/**,.vercel/**,node_modules/**,vercel.json,.vercelignore}"
    },
    "api/save.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.git,.git/**,**/.git/**,.env,.env.*,storage/**,.vercel/**,node_modules/**,vercel.json,.vercelignore}"
    },
    "api/undo.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{.git,.git/**,**/.git/**,.env,.env.*,storage/**,.vercel/**,node_modules/**,vercel.json,.vercelignore}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/api/([a-z][a-z0-9-]*)(\\.php)?", "dest": "/api/$1.php" },
    { "src": "/css/(.*)", "dest": "/app/css/$1" },
    { "src": "/js/(.*)", "dest": "/app/js/$1" },
    { "src": "/assets/(.*)", "dest": "/app/assets/$1" },
    { "src": "/login", "dest": "/app/login.html" },
    { "src": "/login\\.html", "dest": "/app/login.html" },
    { "src": "/reset", "dest": "/app/reset.html" },
    { "src": "/reset\\.html", "dest": "/app/reset.html" },
    { "src": "/demo", "dest": "/app/demo.html" },
    { "src": "/demo\\.html", "dest": "/app/demo.html" },
    { "src": "/index\\.html", "dest": "/app/index.html" },
    { "src": "/", "dest": "/app/index.html" },
    { "src": "/(.*)", "dest": "/app/$1" }
  ]
}
