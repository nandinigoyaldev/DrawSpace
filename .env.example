# ── DrawSpace · environment template ──────────────────────────────
# 1. Copy this file to .env       (cp .env.example .env)
# 2. Fill in your real values
# 3. .env is git-ignored — NEVER commit real credentials
#
# Option A: Full Connection URI (Recommended for Aiven / Cloud MySQL)
# DATABASE_URL=mysql://avnadmin:your_password@mysql-xyz.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Option B: Individual Variables
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drawspace
DB_USER=drawspace_user
DB_PASS=change_me
DB_SSL=true

# Set APP_DEBUG=true temporarily on Vercel to inspect DB errors in browser console / network tab
APP_ENV=production
APP_DEBUG=false
