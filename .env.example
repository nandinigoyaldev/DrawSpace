# ── App ────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=false

# ── Database ───────────────────────────────────────
# postgres (Neon), mysql, or sqlite
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=drawspace
DB_USER=postgres
DB_PASS=

# Neon and most managed PostgreSQL services require TLS.
DB_SSL=false
DB_SSL_VERIFY=true

# Only used when DB_DRIVER=sqlite (relative to the project root or absolute).
DB_PATH=storage/drawspace.sqlite

# ── Sessions ───────────────────────────────────────
# Session lifetime in days (1–90).
SESSION_TTL_DAYS=14

# ── Proxy / hosting ────────────────────────────────
# Set to true when a trusted non-Vercel proxy sits in front of PHP. Vercel is
# detected automatically. This enables forwarded client and HTTPS headers.
TRUST_PROXY=false

# ── Google OAuth ──────────────────────────────────
# Set these in Vercel Environment Variables, never in committed files.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/google.php?action=callback
