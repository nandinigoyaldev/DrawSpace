# ── App ────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=false

# ── Database ───────────────────────────────────────
# mysql (default) or sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drawspace
DB_USER=drawspace
DB_PASS=

# Managed MySQL usually needs TLS. DB_SSL_VERIFY=true requires a trusted CA.
DB_SSL=false
DB_SSL_VERIFY=true
# DB_SSL_CA=/path/to/ca.pem

# Only used when DB_DRIVER=sqlite (relative to the project root or absolute).
DB_PATH=storage/drawspace.sqlite

# ── Sessions ───────────────────────────────────────
# Session lifetime in days (1–90).
SESSION_TTL_DAYS=14

# ── Proxy / hosting ────────────────────────────────
# Set to true only when a trusted proxy (Vercel, a load balancer…) sits in
# front of PHP. It enables reading X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=false
