# ── App ────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=false

# ── Database ───────────────────────────────────────
# postgres (Neon), mysql, or sqlite
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=drawspace
DB_USER=postgres
DB_PASS=

# Neon and most managed PostgreSQL services require TLS.
DB_SSL=false
DB_SSL_VERIFY=true
# Optional for Neon when the endpoint cannot be derived from DB_HOST.
# DB_ENDPOINT=ep-example
# Alternatively, use the complete Neon connection string instead of DB_*:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Only used when DB_DRIVER=sqlite (relative to the project root or absolute).
DB_PATH=storage/drawspace.sqlite

# ── Sessions ───────────────────────────────────────
# Session lifetime in days (1–90).
SESSION_TTL_DAYS=14

# ── Proxy / hosting ────────────────────────────────
# Set to true when a trusted non-Vercel proxy sits in front of PHP. Vercel is
# detected automatically. This enables forwarded client and HTTPS headers.
TRUST_PROXY=false
