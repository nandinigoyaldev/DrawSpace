# ── DrawSpace · environment template ──────────────────────────────
# 1. Copy this file to .env       (cp .env.example .env)
# 2. Fill in your real values
# 3. .env is git-ignored — NEVER commit real credentials
#
# On shared hosting you can also set these as "Environment Variables"
# in cPanel, or just define them in your PHP-FPM / Apache config.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drawspace
DB_USER=drawspace_user
DB_PASS=change_me

# Optional: 'production' hides PHP errors in the browser
APP_ENV=production
APP_DEBUG=false
